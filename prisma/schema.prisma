generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODUL BARU: Sistem Autentikasi (SaaS Ready)
// ==========================================
model User {
  id            String   @id // Diisi dengan Clerk User ID (user_2...)
  email         String   @unique
  name          String?
  role          Role     @default(MEMBER)

  tier          SubscriptionTier @default(FREE)
  maxWallets    Int              @default(1) // Akun gratis cuma bisa add 1 wallet
  
  wallets       Wallet[] // Relasi: 1 User bisa punya banyak Wallet
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  OWNER
  MEMBER
}

// 👇 1. TAMBAHIN ENUM INI 👇
enum SubscriptionTier {
  FREE
  SCOUT
  PREDATOR
  APEX
  }

// ==========================================
// MODUL UTAMA: Wallet & Radar
// ==========================================
model Wallet {
  id            String          @id @default(cuid())
  /// Store EVM addresses in lowercase. Untuk BTC & SOL tetap Case-Sensitive.
  address       String
  name          String?         // Alias untuk paus 
  network       Network
  isActive      Boolean         @default(true)
  
  // 🔴 PENENTU KEPEMILIKAN: Hubungkan ke User
  userId        String?         // ID User pemilik wallet ini
  
  // 🔥 FIX 1: Tambah onDelete: Cascade.
  // Kalau User dihapus -> Wallet lenyap -> Transaction & Position ikut lenyap.
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fitur Notifikasi & Caching
  chatId        String?         // ID Telegram User (Japri/Asisten)
  alphaChannelId String?        // 🔴 ID Telegram Channel (Alpha Feed Khusus User Ini)
  lastBalance   Decimal         @default(0) @db.Decimal(38, 18)
  
  // FILTER DINAMIS: Batas minimal transaksi buat tembus ke Alpha Feed
  minAlertUsd   Float?          @default(100)
  
  // MODUL BARU: Win Rate (WR) & Performa Paus
  winRate       Float           @default(0.0) 
  totalTrades   Int             @default(0)   
  successTrades Int             @default(0)   
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  transactions  Transaction[]
  positions     TokenPosition[] 

  // 🔥 INI FIX NYA: Gabungan Address + Network + UserID jadi gembok unik 🔥
  @@unique([address, network, userId])
  @@index([network, isActive])
  @@index([chatId])
  @@index([userId]) // Index biar load dashboard user makin kenceng             
}

// ==========================================
// MODUL TRACKING: Portfolio & History
// ==========================================
model TokenPosition {
  id               String   @id @default(cuid())
  walletId         String
  
  tokenAddress     String   
  tokenSymbol      String?
  tokenAmount      Decimal  @default(0) @db.Decimal(38, 18) 
  totalInvestedUsd Decimal  @default(0) @db.Decimal(38, 18) 
  avgBuyPriceUsd   Decimal  @default(0) @db.Decimal(38, 18) 
  realizedPnlUsd   Decimal  @default(0) @db.Decimal(38, 18) 

  updatedAt        DateTime @updatedAt
  
  wallet           Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, tokenAddress])
  @@index([walletId])
}

model Transaction {
  id           String   @id @default(cuid())
  walletId     String
  dedupeKey    String   @unique
  signature    String
  
  type         String   
  amount       Decimal  @db.Decimal(38, 18)
  tokenSymbol  String
  tokenAddress String?
  usdValue     Decimal  @db.Decimal(18, 2)
  explorerUrl  String
  
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([signature])
}

enum Network {
  BITCOIN
  SOLANA
  ETHEREUM
  BASE
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODUL BARU: Sistem Autentikasi (SaaS Ready)
// ==========================================
model User {
  id            String   @id // Diisi dengan Clerk User ID (user_2...)
  email         String   @unique
  name          String?
  role          Role     @default(MEMBER)

  tier          SubscriptionTier @default(FREE)
  maxWallets    Int              @default(1) // Akun gratis cuma bisa add 1 wallet
  
  // FITUR NO 4: Portfolio "Shadowing" Mode
  shadowBalance Float            @default(100.0) // Modal kertas (simulasi) buat ngitung "What If" PnL

  wallets       Wallet[] // Relasi: 1 User bisa punya banyak Wallet
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  OWNER
  MEMBER
}

enum SubscriptionTier {
  FREE
  SCOUT
  PREDATOR
  APEX
}

// ==========================================
// MODUL UTAMA: Wallet & Radar
// ==========================================
model Wallet {
  id            String          @id @default(cuid())
  /// Store EVM addresses in lowercase. Untuk BTC & SOL tetap Case-Sensitive.
  address       String
  name          String?         // Alias untuk paus 
  network       Network
  isActive      Boolean         @default(true)
  
  // PENENTU KEPEMILIKAN: Hubungkan ke User
  userId        String?         // ID User pemilik wallet ini
  
  // FIX 1: Tambah onDelete: Cascade.
  // Kalau User dihapus -> Wallet lenyap -> Transaction & Position ikut lenyap.
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fitur Notifikasi & Caching
  chatId        String?         // ID Telegram User (Japri/Asisten)
  alphaChannelId String?        // ID Telegram Channel (Alpha Feed Khusus User Ini)
  lastBalance   Decimal         @default(0) @db.Decimal(38, 18)
  
  // FILTER DINAMIS: Batas minimal transaksi buat tembus ke Alpha Feed
  minAlertUsd   Float?          @default(100)
  
  // MODUL BARU: Win Rate (WR) & Performa Paus
  winRate       Float           @default(0.0) 
  totalTrades   Int             @default(0)   
  successTrades Int             @default(0)   
  
  // FITUR NO 2: Hold Duration Tagging
  tradeStyle    TradeStyle      @default(UNKNOWN) // Label gaya trading

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  transactions  Transaction[]
  positions     TokenPosition[]

  // INI FIX NYA: Gabungan Address + Network + UserID jadi gembok unik
  @@unique([address, network, userId])
  @@index([network, isActive])
  @@index([chatId])
  @@index([userId]) // Index biar load dashboard user makin kenceng             
}

// ==========================================
// MODUL TRACKING: Portfolio & History
// ==========================================
model TokenPosition {
  id               String   @id @default(cuid())
  walletId         String
  
  tokenAddress     String   
  tokenSymbol      String?
  tokenAmount      Decimal  @default(0) @db.Decimal(38, 18) 
  totalInvestedUsd Decimal  @default(0) @db.Decimal(38, 18) 
  avgBuyPriceUsd   Decimal  @default(0) @db.Decimal(38, 18) 
  realizedPnlUsd   Decimal  @default(0) @db.Decimal(38, 18) 

  updatedAt        DateTime @updatedAt
  
  wallet           Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, tokenAddress])
  @@index([walletId])
}

model Transaction {
  id           String   @id @default(cuid())
  walletId     String
  dedupeKey    String   @unique
  signature    String
  
  type         String   
  amount       Decimal  @db.Decimal(38, 18)
  tokenSymbol  String
  tokenAddress String?
  usdValue     Decimal  @db.Decimal(18, 2)
  explorerUrl  String
  
  // MODUL BARU: Sinyal Confluency (Data Mentah Saat Transaksi)
  // Biar lu punya rekam jejak harga saat paus beli (buat backtest atau di-show di UI kalau perlu)
  priceAtTx    Decimal? @db.Decimal(38, 18) // Harga koin pas transaksi
  ema50AtTx    Decimal? @db.Decimal(38, 18) // Nilai EMA-50 saat transaksi (Indikator Tren)
  rsi14AtTx    Decimal? @db.Decimal(18, 2)  // Nilai RSI-14 saat transaksi (Indikator Momentum)
  
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([signature])
}

// ==========================================
// MODUL BARU: Whale Panic / Exit Alert Log (Fitur No 1)
// ==========================================
model SaleEvent {
  id           String   @id @default(cuid())
  walletId     String
  tokenAddress String
  tokenSymbol  String
  usdValue     Decimal  @db.Decimal(18, 2)
  
  createdAt    DateTime @default(now())

  // Index ini sangat krusial biar database nggak lemot pas ngecek "3 paus jual dalam 1 jam"
  @@index([tokenAddress, createdAt(sort: Desc)])
}

enum Network {
  BITCOIN
  SOLANA
  ETHEREUM
  BASE
}

// ==========================================
// ENUM BARU: Gaya Trading Paus (Fitur No 2)
// ==========================================
enum TradeStyle {
  UNKNOWN
  SCALPER       // Hit and run (hitungan menit/jam)
  SWING_TRADER  // Hold beberapa hari
  DIAMOND_HANDS // Hold sampai ribuan persen / jangka panjang
}

// ==========================================
// ENUM BARU: Status Confluency dari AI
// ==========================================
enum ConfluenceSignal {
  PENDING
  SUPER_ALPHA   // Trend & Momentum mendukung
  HIGH_RISK     // Paus beli tapi nabrak trend/momentum
  NEUTRAL
}

// ==========================================
// MODUL BARU: AI Mindshare Cache (Fitur ala Kaito)
// ==========================================
model TokenIntel {
  id           String   @id @default(cuid())
  tokenAddress String   @unique // Jadiin patokan biar AI gak nge-scan koin yang sama 2x
  tokenSymbol  String
  
  // Hasil Analisis Gemini API
  narrative    String   @default("Unknown") // Label: "AI Memecoin", "RWA", "DeFi", dll
  aiScore      Int      @default(0)         // Tingkat kepercayaan/skor keamanan (0-100)
  mindshare    String   @default("Low")     // Status hype: "Early Alpha", "Trending", atau "Hype Train"
  
  // MODUL BARU: Sinyal Confluency (Hasil Terjemahan AI)
  // Ini yang bakal lu pake buat nampilin Badge elegan di UI lu
  confluence   ConfluenceSignal @default(PENDING) 
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tokenAddress])
}
{
  "name": "predator-tracker",
  "version": "1.0.0",
  "description": "Whale Tracking Dashboard for Solana, Ethereum, and Base",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "cross-env NEXT_DEV_BUNDLER=webpack next dev",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranatapramudya/predator-tracker.git"
  },
  "author": "Pranata Pramudya",
  "license": "ISC",
  "dependencies": {
    "@clerk/nextjs": "^7.2.7",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "lucide-react": "^0.473.0",
    "next": "^16.2.4",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "svix": "^1.92.2",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.10",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  }
}
